      "settings": {
        "custom_liquid": "<style>\n/* =========================================================\n   MERCHERA — SIZE CHART SECTION\n   ========================================================= */\n\n.merchera-size-guide {\n  --merch-burgundy: #641F1F;\n  --merch-burgundy-dark: #4F1717;\n  --merch-ivory: #F5EEE5;\n  --merch-espresso: #211B18;\n  --merch-white: #FFFDF9;\n  --merch-border: #D5C6B7;\n  --merch-champagne: #D8C7B5;\n  --merch-gray: #E9DDD0;\n  --merch-muted: #6F625A;\n\n  background: var(--merch-ivory);\n  color: var(--merch-espresso);\n  font-family: inherit;\n  overflow: hidden;\n  width: 100%;\n  padding: 64px 20px 72px;\n}\n\n.merchera-size-guide *,\n.merchera-size-guide *::before,\n.merchera-size-guide *::after {\n  box-sizing: border-box;\n}\n\n.merchera-size-guide .msg-container {\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n}\n\n.merchera-size-guide .msg-section-heading {\n  text-align: center;\n  margin-bottom: 48px;\n}\n\n.merchera-size-guide .msg-section-heading .small {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 16px;\n  border-radius: 999px;\n  background: rgba(100, 31, 31, 0.09);\n  border: 1px solid rgba(100, 31, 31, 0.22);\n  color: var(--merch-burgundy);\n  font-size: 11.5px;\n  font-weight: 800;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  margin-bottom: 16px;\n}\n\n.merchera-size-guide .msg-section-heading h1 {\n  margin: 0 0 14px;\n  color: var(--merch-espresso);\n  font-size: clamp(32px, 4.5vw, 52px);\n  line-height: 1.08;\n  letter-spacing: -0.03em;\n  font-weight: 800;\n}\n\n.merchera-size-guide .msg-section-heading h1 span {\n  color: var(--merch-burgundy);\n}\n\n.merchera-size-guide .msg-section-heading p {\n  max-width: 640px;\n  margin: 0 auto;\n  color: var(--merch-muted);\n  line-height: 1.7;\n  font-size: 16px;\n}\n\n/* =========================================================\n   APPAREL SIZE CHART LAYOUT\n   ========================================================= */\n\n.merchera-size-guide .msg-apparel {\n  display: grid;\n  grid-template-columns: 0.9fr 1.3fr;\n  gap: 44px;\n  align-items: stretch;\n}\n\n.merchera-size-guide .msg-apparel-visual {\n  position: relative;\n  min-height: 460px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid var(--merch-border);\n  border-radius: 28px;\n  background: var(--merch-white);\n  overflow: hidden;\n  box-shadow: 0 18px 40px -12px rgba(33, 27, 24, 0.08);\n}\n\n.merchera-size-guide .msg-apparel-visual::before {\n  content: \"\";\n  position: absolute;\n  width: 320px;\n  height: 320px;\n  border-radius: 50%;\n  background: var(--merch-gray);\n  animation: msgVisualFloat 5s ease-in-out infinite;\n}\n\n@keyframes msgVisualFloat {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-12px); }\n}\n\n.merchera-size-guide .msg-shirt-svg {\n  position: relative;\n  z-index: 2;\n  width: 230px;\n  height: 285px;\n  filter: drop-shadow(0 18px 18px rgba(33, 27, 24, 0.11));\n  animation: msgShirtFloat 4.5s ease-in-out infinite;\n}\n\n@keyframes msgShirtFloat {\n  0%, 100% { transform: translateY(0) rotate(0deg); }\n  50% { transform: translateY(-8px) rotate(1deg); }\n}\n\n.merchera-size-guide .msg-measure-line {\n  position: absolute;\n  z-index: 4;\n  background: var(--merch-burgundy);\n}\n\n.merchera-size-guide .msg-measure-line::before,\n.merchera-size-guide .msg-measure-line::after {\n  content: \"\";\n  position: absolute;\n  width: 8px;\n  height: 8px;\n  border: 1.5px solid var(--merch-burgundy);\n  border-radius: 50%;\n  background: var(--merch-white);\n}\n\n.merchera-size-guide .msg-chest-line {\n  width: 210px;\n  height: 1px;\n  top: 47%;\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.merchera-size-guide .msg-chest-line::before { left: -4px; top: -4px; }\n.merchera-size-guide .msg-chest-line::after { right: -4px; top: -4px; }\n\n.merchera-size-guide .msg-length-line {\n  width: 1px;\n  height: 225px;\n  top: 25%;\n  left: 78%;\n}\n\n.merchera-size-guide .msg-length-line::before { left: -4px; top: -4px; }\n.merchera-size-guide .msg-length-line::after { left: -4px; bottom: -4px; }\n\n.merchera-size-guide .msg-measure-label {\n  position: absolute;\n  z-index: 5;\n  padding: 7px 12px;\n  border: 1px solid var(--merch-border);\n  border-radius: 50px;\n  background: var(--merch-white);\n  color: var(--merch-burgundy);\n  font-size: 11px;\n  font-weight: 800;\n  box-shadow: 0 7px 20px rgba(33, 27, 24, 0.06);\n}\n\n.merchera-size-guide .msg-chest-label {\n  top: 41%;\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.merchera-size-guide .msg-length-label {\n  top: 17%;\n  right: 6%;\n}\n\n/* =========================================================\n   SIZE TABLE CARD\n   ========================================================= */\n\n.merchera-size-guide .msg-size-content {\n  background: var(--merch-white);\n  border: 1px solid var(--merch-border);\n  border-radius: 28px;\n  padding: 36px 34px;\n  box-shadow: 0 18px 40px -12px rgba(33, 27, 24, 0.08);\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.merchera-size-guide .msg-size-content h2 {\n  margin: 0 0 8px;\n  color: var(--merch-espresso);\n  font-size: 26px;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n}\n\n.merchera-size-guide .msg-size-content > div > p {\n  margin: 0 0 18px;\n  color: var(--merch-muted);\n  line-height: 1.65;\n  font-size: 14.5px;\n}\n\n.merchera-size-guide .msg-bullet-list {\n  list-style: none;\n  padding: 0;\n  margin: 0 0 22px;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));\n  gap: 10px;\n}\n\n.merchera-size-guide .msg-bullet-list li {\n  background: var(--merch-ivory);\n  border: 1px solid var(--merch-border);\n  border-radius: 12px;\n  padding: 10px 14px;\n  font-size: 13.5px;\n  color: var(--merch-espresso);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.merchera-size-guide .msg-bullet-list li::before {\n  content: \"•\";\n  color: var(--merch-burgundy);\n  font-weight: 900;\n  font-size: 18px;\n  line-height: 1;\n}\n\n.merchera-size-guide .msg-bullet-list li strong {\n  color: var(--merch-burgundy);\n  font-weight: 800;\n}\n\n.merchera-size-guide .msg-table-wrap {\n  overflow-x: auto;\n  border: 1px solid var(--merch-border);\n  border-radius: 18px;\n  background: var(--merch-white);\n}\n\n.merchera-size-guide .msg-table {\n  width: 100%;\n  min-width: 460px;\n  border-collapse: collapse;\n}\n\n.merchera-size-guide .msg-table th {\n  padding: 15px 18px;\n  background: var(--merch-burgundy);\n  color: var(--merch-white);\n  text-align: left;\n  font-size: 12px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  font-weight: 800;\n}\n\n.merchera-size-guide .msg-table td {\n  padding: 15px 18px;\n  text-align: left;\n  color: var(--merch-espresso);\n  border-bottom: 1px solid var(--merch-border);\n  font-size: 14.5px;\n  font-weight: 600;\n}\n\n.merchera-size-guide .msg-table tr:nth-child(even) td {\n  background: rgba(245, 238, 229, 0.45);\n}\n\n.merchera-size-guide .msg-table tr:hover td {\n  background: rgba(100, 31, 31, 0.06);\n}\n\n.merchera-size-guide .msg-table tr:last-child td {\n  border-bottom: 0;\n}\n\n.merchera-size-guide .msg-table td:first-child {\n  color: var(--merch-burgundy);\n  font-weight: 800;\n}\n\n.merchera-size-guide .msg-note {\n  margin-top: 20px;\n  padding: 14px 18px;\n  border-left: 3px solid var(--merch-burgundy);\n  border-radius: 0 12px 12px 0;\n  background: var(--merch-ivory);\n  color: var(--merch-muted);\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n.merchera-size-guide .msg-note strong {\n  color: var(--merch-espresso);\n}\n\n@media screen and (max-width: 991px) {\n  .merchera-size-guide .msg-apparel {\n    grid-template-columns: 1fr;\n  }\n  .merchera-size-guide .msg-apparel-visual {\n    min-height: 360px;\n  }\n  .merchera-size-guide .msg-size-content {\n    padding: 26px 20px;\n  }\n}\n</style>\n\n<div class=\"merchera-size-guide\">\n  <div class=\"msg-container\">\n    <section id=\"msg-apparel-section\" class=\"msg-section\">\n      <div class=\"msg-section-heading\" data-mc-reveal=\"fade-up\">\n        <span class=\"small\">✦ MERCHERA SIZE CHART</span>\n        <h1>General Men’s Polo <span>Size Chart (Inches)</span></h1>\n        <p>Find your ideal fit using our chest and length measurements below before customising your order.</p>\n      </div>\n\n      <div class=\"msg-apparel\">\n        <!-- SHIRT VISUAL -->\n        <div class=\"msg-apparel-visual\" data-mc-tilt data-mc-reveal=\"slide-left\">\n          <svg class=\"msg-shirt-svg\" viewBox=\"0 0 220 280\" fill=\"none\">\n            <path d=\"M72 30L35 48L15 88L48 108L62 82V245H158V82L172 108L205 88L185 48L148 30C140 42 80 42 72 30Z\" fill=\"#FFFDF9\" stroke=\"#211B18\" stroke-width=\"3\"/>\n            <path d=\"M72 30C78 48 142 48 148 30\" stroke=\"#211B18\" stroke-width=\"3\"/>\n            <path d=\"M62 82V245M158 82V245\" stroke=\"#D5C6B7\" stroke-width=\"1.5\"/>\n            <path d=\"M82 65H138\" stroke=\"#641F1F\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n          </svg>\n          <div class=\"msg-measure-line msg-chest-line\"></div>\n          <span class=\"msg-measure-label msg-chest-label\">CHEST (INCHES)</span>\n          <div class=\"msg-measure-line msg-length-line\"></div>\n          <span class=\"msg-measure-label msg-length-label\">LENGTH (INCHES)</span>\n        </div>\n\n        <!-- SIZE CHART TABLE & SUMMARY -->\n        <div class=\"msg-size-content\" data-mc-reveal=\"fade-up\">\n          <div>\n            <h2>General Men’s Polo Size Chart (Inches)</h2>\n            <p>Standard chest and garment length measurements across sizes Small (S) to 2XL (XXL):</p>\n\n            <ul class=\"msg-bullet-list\">\n              <li><span><strong>Small (S):</strong> Chest 36\"–38\" | Length ~27\"</span></li>\n              <li><span><strong>Medium (M):</strong> Chest 39\"–41\" | Length ~28\"</span></li>\n              <li><span><strong>Large (L):</strong> Chest 42\"–44\" | Length ~29\"</span></li>\n              <li><span><strong>Extra Large (XL):</strong> Chest 45\"–47\" | Length ~30\"</span></li>\n              <li><span><strong>2XL (XXL):</strong> Chest 48\"–50\" | Length ~30.5\"–31\"</span></li>\n            </ul>\n\n            <div class=\"msg-table-wrap\">\n              <table class=\"msg-table\">\n                <thead>\n                  <tr>\n                    <th>SIZE</th>\n                    <th>CHEST (INCHES)</th>\n                    <th>LENGTH (INCHES)</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td>Small (S)</td>\n                    <td>Chest 36\"–38\"</td>\n                    <td>Length ~27\"</td>\n                  </tr>\n                  <tr>\n                    <td>Medium (M)</td>\n                    <td>Chest 39\"–41\"</td>\n                    <td>Length ~28\"</td>\n                  </tr>\n                  <tr>\n                    <td>Large (L)</td>\n                    <td>Chest 42\"–44\"</td>\n                    <td>Length ~29\"</td>\n                  </tr>\n                  <tr>\n                    <td>Extra Large (XL)</td>\n                    <td>Chest 45\"–47\"</td>\n                    <td>Length ~30\"</td>\n                  </tr>\n                  <tr>\n                    <td>2XL (XXL)</td>\n                    <td>Chest 48\"–50\"</td>\n                    <td>Length ~30.5\"–31\"</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          <div class=\"msg-note\">\n            <strong>Fit Guidance:</strong> Measure around the fullest part of your chest and from the highest shoulder point down to the hem.\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n</div>",
