          <div class="mc-comm-overlay"></div>
          <span class="mc-comm-top-badge">✦ HD Screen Print</span>
          <span class="mc-comm-location">Manchester, UK</span>
          <span class="mc-comm-hover-pill">Shop This Blank →</span>
        </div>
        <div class="mc-comm-body">
          <h3 class="mc-comm-creator">Apex Movement Studio</h3>
          <p class="mc-comm-details">
            Vintage-washed 240 GSM combed cotton tees printed with zero-hand breathable water inks for studio classes and seasonal pop-up drops.
          </p>
          <div class="mc-comm-tags">
            <span class="mc-comm-tag">✦ High-Definition Ink</span>
            <span class="mc-comm-tag">✦ Vintage Wash Blank</span>
          </div>
        </div>
      </a>

      <!-- Card 3 (Standard 1) -->
      <a href="/collections/all" class="mc-comm-card mc-comm-card--standard" data-mc-tilt data-mc-reveal="fade-up" style="--mc-delay: 150ms;">
