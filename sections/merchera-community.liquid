          <h3 class="mc-comm-creator">Studio Neue Architecture</h3>
          <p class="mc-comm-details">6-panel structured caps with tonal micro-monogram stitch.</p>
          <div class="mc-comm-tags">
            <span class="mc-comm-tag">✦ Micro-Stitch</span>
          </div>
        </div>
      </a>

      <!-- Card 4 (Standard 2) -->
      <a href="/collections/all" class="mc-comm-card mc-comm-card--standard" data-mc-tilt data-mc-reveal="fade-up" style="--mc-delay: 200ms;">
        <div class="mc-comm-img-box">
