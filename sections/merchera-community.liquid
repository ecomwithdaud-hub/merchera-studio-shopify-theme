          <h3 class="mc-comm-creator">Nomad Creative Collective</h3>
          <p class="mc-comm-details">Reinforced 16oz cotton canvas totes with double-pass ink.</p>
          <div class="mc-comm-tags">
            <span class="mc-comm-tag">✦ Heavyweight Canvas</span>
          </div>
        </div>
      </a>

      <!-- Card 6 (Standard 4) -->
      <a href="/collections/all" class="mc-comm-card mc-comm-card--standard" data-mc-tilt data-mc-reveal="fade-up" style="--mc-delay: 300ms;">
        <div class="mc-comm-img-box">
          <img
            src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?auto=format&fit=crop&w=700&q=80"
            alt="Heritage Craft Guild Polo"
            class="mc-comm-img"
            loading="lazy"
            width="700"
            height="700"
          >
          <div class="mc-comm-overlay"></div>
          <span class="mc-comm-top-badge">✦ Luxury Polo</span>
          <span class="mc-comm-location">Soho, London</span>
          <span class="mc-comm-hover-pill">View Polo →</span>
        </div>
        <div class="mc-comm-body">
          <h3 class="mc-comm-creator">Heritage Craft Guild</h3>
          <p class="mc-comm-details">Organic piqué polo shirts with 1,200 stitches/in² studio crest.</p>
          <div class="mc-comm-tags">
            <span class="mc-comm-tag">✦ Organic Piqué</span>
          </div>
        </div>
      </a>
    </div>

    <!-- Community Banner Footer -->
    <div class="mc-comm-footer" data-mc-reveal="fade-up">
      <div class="mc-comm-footer__text">
        <span class="mc-comm-footer__icon">✦</span>
        <div>
          <h4 class="mc-comm-footer__title">Share Your Creation with the Atelier</h4>
          <p class="mc-comm-footer__desc">
            Tag <strong>@Merchera</strong> or <strong>#CraftedByMerchera</strong> on Instagram to be featured in the community gallery and receive 15% off your next studio batch.
          </p>
        </div>
      </div>
      <a href="/collections/all" class="mc-comm-footer__btn" data-mc-magnetic="0.2">
        <span>Explore All Studio Blanks</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

