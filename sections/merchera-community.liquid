      </a>

      <!-- Card 5 (Standard 3) -->
      <a href="/collections/all" class="mc-comm-card mc-comm-card--standard" data-mc-tilt data-mc-reveal="fade-up" style="--mc-delay: 250ms;">
        <div class="mc-comm-img-box">
