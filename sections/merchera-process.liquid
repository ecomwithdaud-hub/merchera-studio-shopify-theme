<style>
  .mc-process-section-{{ section.id }} {
    position: relative;
    padding: 96px 20px;
    background: #fffdf9;
    border-top: 1px solid #d5c6b7;
    border-bottom: 1px solid #d5c6b7;
    overflow: hidden;
  }

  .mc-process-container {
    max-width: 1360px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .mc-process-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 64px;
  }

  .mc-process-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 999px;
    background: #f5eee5;
    border: 1px solid #d5c6b7;
    color: #641f1f;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .mc-process-title {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    color: #211b18;
    margin: 0 0 14px;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .mc-process-subtitle {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(33, 27, 24, 0.72);
    margin: 0;
  }

  .mc-process-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 64px;
  }

  /* Connecting animated line behind step cards on desktop */
  .mc-process-steps::before {
    content: "";
    position: absolute;
    top: 48px;
    left: 10%;
    right: 10%;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(213, 198, 183, 0.3),
      #641f1f 50%,
      rgba(213, 198, 183, 0.3)
    );
    background-size: 200% 100%;
    animation: mcFlowLine 6s ease-in-out infinite;
    z-index: 0;
  }

  @keyframes mcFlowLine {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .mc-step-card {
    position: relative;
    z-index: 1;
    background: #f5eee5;
    border: 1px solid #d5c6b7;
    border-radius: 22px;
    padding: 32px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease,
      background-color 0.35s ease;
  }

  .mc-step-card:hover {
    background: #fffdf9;
    border-color: #641f1f;
    box-shadow: 0 24px 48px -12px rgba(100, 31, 31, 0.16);
  }

  .mc-step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mc-step-icon {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: #641f1f;
    color: #fffdf9;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px -6px rgba(100, 31, 31, 0.4);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mc-step-card:hover .mc-step-icon {
    transform: scale(1.1) rotate(-6deg);
  }

  .mc-step-number {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #641f1f;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(100, 31, 31, 0.08);
    border: 1px solid rgba(100, 31, 31, 0.18);
  }

  .mc-step-title {
    font-size: 20px;
    font-weight: 700;
    color: #211b18;
    margin: 4px 0 0;
    line-height: 1.3;
  }

  .mc-step-desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: rgba(33, 27, 24, 0.74);
    margin: 0;
  }

  .mc-step-tag {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed rgba(213, 198, 183, 0.9);
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #641f1f;
    letter-spacing: 0.04em;
  }

  /* Animated Studio Metrics Banner */
  .mc-metrics-bar {
    background: linear-gradient(135deg, #641f1f 0%, #451313 100%);
    color: #fffdf9;
    border-radius: 26px;
    padding: 40px 36px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    box-shadow: 0 24px 54px -12px rgba(100, 31, 31, 0.38);
    position: relative;
    overflow: hidden;
  }

  .mc-metrics-bar::after {
    content: "";
    position: absolute;
    top: -50%;
    right: -10%;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 253, 249, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .mc-metric-item {
    text-align: center;
    padding: 8px 16px;
    border-right: 1px solid rgba(255, 253, 249, 0.16);
    position: relative;
    z-index: 1;
  }

  .mc-metric-item:last-child {
    border-right: none;
  }

  .mc-metric-value {
    font-size: clamp(32px, 3.8vw, 46px);
    font-weight: 700;
    line-height: 1.1;
    color: #fffdf9;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .mc-metric-label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 238, 229, 0.82);
  }

  @media screen and (max-width: 1024px) {
    .mc-process-steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .mc-process-steps::before {
      display: none;
    }
    .mc-metrics-bar {
      grid-template-columns: repeat(2, 1fr);
      padding: 32px 24px;
    }
    .mc-metric-item:nth-child(2) {
      border-right: none;
    }
  }

  @media screen and (max-width: 576px) {
    .mc-process-section-{{ section.id }} {
      padding: 64px 20px;
    }
    .mc-process-steps {
      grid-template-columns: 1fr;
    }
    .mc-metrics-bar {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .mc-metric-item {
      border-right: none;
      border-bottom: 1px solid rgba(255, 253, 249, 0.14);
      padding-bottom: 18px;
    }
    .mc-metric-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
  }
</style>

<section class="mc-process-section-{{ section.id }}">
  <div class="mc-process-container">
    <div class="mc-process-header" data-mc-reveal="fade-up">
      <div class="mc-process-eyebrow">
        <span>✦</span>
        <span>{{ section.settings.eyebrow | default: 'THE MERCHERA STUDIO FLOW' }}</span>
      </div>
      <h2 class="mc-process-title">
        {{ section.settings.heading | default: 'From Concept to Custom Masterpiece' }}
      </h2>
      <p class="mc-process-subtitle">
        {{ section.settings.subheading | default: 'Whether you are launching a streetwear label, outfitting your team, or crafting bespoke event merch, our 4-step studio process guarantees retail-grade perfection.' }}
      </p>
    </div>

    <div class="mc-process-steps">
      <!-- Step 1 -->
      <div class="mc-step-card" data-mc-tilt data-mc-reveal="fade-up" style="--mc-delay: 0ms;">
        <div class="mc-step-top">
          <div class="mc-step-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>
            </svg>
          </div>
          <span class="mc-step-number">STEP 01</span>
        </div>
        <h3 class="mc-step-title">Choose Your Canvas</h3>
        <p class="mc-step-desc">
          Pick from heavyweight drop-shoulder hoodies, combed cotton polos, round-bottom tees, heavy canvas totes, caps, or luxury cards.
        </p>
        <div class="mc-step-tag">
          <span>✓</span>
          <span>100% Ring-Spun & Heavyweight Blanks</span>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="mc-step-card" data-mc-tilt data-mc-reveal="fade-up" style="--mc-delay: 110ms;">
        <div class="mc-step-top">
          <div class="mc-step-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 19l7-7 3 3-7 7-3-3z"/>
              <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
              <path d="M2 2l7.586 7.586"/>
              <circle cx="11" cy="11" r="2"/>
            </svg>
          </div>
          <span class="mc-step-number">STEP 02</span>
        </div>
        <h3 class="mc-step-title">Upload & Customise</h3>
        <p class="mc-step-desc">
          Apply your brand artwork, monogram, or custom graphics using high-density 3D embroidery or ultra-vibrant DTG & screen printing.
        </p>
        <div class="mc-step-tag">
          <span>✓</span>
          <span>Razor-Sharp Stitch & Print Detail</span>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="mc-step-card" data-mc-tilt data-mc-reveal="fade-up" style="--mc-delay: 220ms;">
        <div class="mc-step-top">
          <div class="mc-step-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <span class="mc-step-number">STEP 03</span>
        </div>
        <h3 class="mc-step-title">Artisan Quality Check</h3>
        <p class="mc-step-desc">
          Our London print specialists inspect colour fidelity, thread tension, and placement accuracy on every single piece before packing.
        </p>
        <div class="mc-step-tag">
          <span>✓</span>
          <span>Multi-Point Studio Inspection</span>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="mc-step-card" data-mc-tilt data-mc-reveal="fade-up" style="--mc-delay: 330ms;">
        <div class="mc-step-top">
          <div class="mc-step-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13" rx="2"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <span class="mc-step-number">STEP 04</span>
        </div>
        <h3 class="mc-step-title">Fast Tracked Delivery</h3>
        <p class="mc-step-desc">
          Dispatched rapidly from our UK studio straight to your doorstep—with complimentary tracked delivery on all orders over £60.
        </p>
        <div class="mc-step-tag">
          <span>✓</span>
          <span>Free UK Shipping Over £60</span>
        </div>
      </div>
    </div>

    <!-- Live Animated Studio Metrics Bar -->
    <div class="mc-metrics-bar" data-mc-reveal="scale-up" style="--mc-delay: 150ms;">
      <div class="mc-metric-item">
        <div class="mc-metric-value" data-mc-counter="15000" data-mc-suffix="+">15,000+</div>
        <div class="mc-metric-label">Custom Pieces Crafted</div>
      </div>
      <div class="mc-metric-item">
        <div class="mc-metric-value" data-mc-counter="99.6" data-mc-decimals="1" data-mc-suffix="%">99.6%</div>
        <div class="mc-metric-label">Print & Stitch Precision</div>
      </div>
      <div class="mc-metric-item">
        <div class="mc-metric-value" data-mc-counter="48" data-mc-suffix="h">48h</div>
        <div class="mc-metric-label">Express UK Studio Dispatch</div>
      </div>
      <div class="mc-metric-item">
        <div class="mc-metric-value" data-mc-counter="4.9" data-mc-decimals="1" data-mc-suffix=" ★">4.9 ★</div>
        <div class="mc-metric-label">Verified Client Rating</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Merchera Studio Process",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Badge",
      "default": "THE MERCHERA STUDIO FLOW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Concept to Custom Masterpiece"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Whether you are launching a streetwear label, outfitting your team, or crafting bespoke event merch, our 4-step studio process guarantees retail-grade perfection."
    }
  ],
  "presets": [
    {
      "name": "Merchera Studio Process"
    }
  ]
}
{% endschema %}
