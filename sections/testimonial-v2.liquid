

<section {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  <xo-container {% render 'section-layout' %}>
    <xo-grid style='--xs:1; --md:2; --xo-grid-col-gap: 80px;'>
      <div class='testimonial-v15__content'>
        <xo-animate xo-cascade>
          <span class='testimonial-v15__icon'>
            {{ section.settings.icon }}
          </span>
          <h2 class='testimonial-v15__title'>
            {{ section.settings.title }}
          </h2>
        </xo-animate>
        <xo-carousel
          class="testimonial-v15__text"
          {% if section.settings.auto_play %}
            xo-autoplay='5000'
          {% endif %}
          xo-speed='200'
          xo-gap='30'
          xo-rewind
          xo-render-bullet='<span></span>'
        >
          <xo-carousel-inner>
            <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
              {% for block in section.blocks %}
                <xo-carousel-slide aria-roledescription='{{ 'sections.slideshow.slide' | t }}' aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}'>
                  <xo-animate xo-cascade class='testimonial-v15__item'>
                    {%- if block.settings.stars > 0 -%}
                      <ul role='list' class='testimonial-v15__list-star'>
                        {% for i in (1..block.settings.stars) %}
                          <li>{% render 'icon', name: 'star', icon_size: '15', color: '#ffc107' %}</li>
                        {% endfor %}
                      </ul>
                    {%- endif -%}
                    {% if block.settings.testimonial %}
                      <div class='testimonial-v15__testimonial'>{{ block.settings.testimonial }}</div>
                    {% endif %}
                    <div class='testimonial-v15__customer'>
                      {% if block.settings.name_customer %}
                        <div class='testimonial-v15__name'>{{ block.settings.name_customer }}</div>
                        <span></span>
                      {% endif %}
                      {% if block.settings.position %}
                        <div class='testimonial-v15__position'>{{ block.settings.position }}</div>
                      {% endif %}
                    </div>
                  </xo-animate>
                </xo-carousel-slide>
              {% endfor %}
            </xo-carousel-list>
          </xo-carousel-inner>
          {% render 'carousel-pagination-style3', class: 'testimonial-v15__pagination' %}
        </xo-carousel>
      </div>
      <div
        class='testimonial-v15__img'
        {% if section.settings.reverse %}
          style='--order-md:-1'
        {% endif %}
      >
        {%- render 'image', image: section.settings.image -%}
      </div>
    </xo-grid>
  </xo-container>
</section>

