{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  .mc-loved-wrapper {
    position: relative;
    padding: 88px 20px;
    background: linear-gradient(180deg, #f5eee5 0%, #efe4d6 50%, #f5eee5 100%);
    overflow: hidden;
  }

  /* Ambient decorative background glow */
  .mc-loved-wrapper::before {
    content: "";
    position: absolute;
    top: -120px;
    right: -120px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(100, 31, 31, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .loved-moments-section {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    margin: 0 auto;
  }

  .mc-loved-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 54px;
  }

  .mc-loved-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(100, 31, 31, 0.09);
    border: 1px solid rgba(100, 31, 31, 0.22);
    color: #641f1f;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .loved-moments-title {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 700;
    color: #211b18;
    margin: 0 0 14px;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .mc-loved-subtitle {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(33, 27, 24, 0.72);
    margin: 0;
  }

  .loved-moments-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  @media screen and (max-width: 991px) {
    .loved-moments-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
    .mc-loved-wrapper {
      padding: 64px 20px;
    }
  }

  @media screen and (max-width: 576px) {
    .loved-moments-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .loved-card {
    position: relative;
    background: #fffdf9;
    border: 1px solid #d5c6b7;
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 12px 32px -12px rgba(33, 27, 24, 0.08);
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease;
  }

  .loved-card:hover {
    border-color: #641f1f;
    box-shadow: 0 26px 52px -14px rgba(100, 31, 31, 0.22);
  }

  .loved-card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 4.2;
    background: #e9ddd0;
    overflow: hidden;
  }

  .loved-card-image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(33, 27, 24, 0.55) 0%,
      rgba(33, 27, 24, 0.08) 45%,
      transparent 100%
    );
    opacity: 0.35;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .loved-card:hover .loved-card-image-wrapper::after {
    opacity: 0.7;
  }

  .loved-card-image-wrapper img,
  .loved-card-image-wrapper svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .loved-card:hover .loved-card-image-wrapper img {
    transform: scale(1.08);
  }

  /* Floating Top Badges */
  .mc-card-top-meta {
    position: absolute;
    top: 16px;
    left: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
    pointer-events: none;
  }

  .mc-card-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 253, 249, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(213, 198, 183, 0.8);
    color: #211b18;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: background 0.35s ease, color 0.35s ease, transform 0.35s ease;
  }

  .loved-card:hover .mc-card-index {
    background: #641f1f;
    color: #fffdf9;
    border-color: #641f1f;
    transform: scale(1.08);
  }

  .mc-card-pill {
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(33, 27, 24, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 253, 249, 0.22);
    color: #fffdf9;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Floating Quick-Action Prompt inside Image */
  .mc-card-hover-cta {
    position: absolute;
    left: 20px;
    bottom: 18px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fffdf9;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .loved-card:hover .mc-card-hover-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .loved-card-content {
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: #fffdf9;
    position: relative;
    z-index: 2;
  }

  .mc-card-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .loved-card-title {
    font-size: 19px;
    font-weight: 700;
    color: #211b18;
    line-height: 1.3;
    margin: 0;
    transition: color 0.25s ease;
  }

  .loved-card:hover .loved-card-title {
    color: #641f1f;
  }

  .mc-card-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .loved-card-stars {
    color: #641f1f;
    font-size: 13px;
    letter-spacing: 2px;
    line-height: 1;
  }

  .mc-card-rating-label {
    font-size: 12px;
    font-weight: 500;
    color: rgba(33, 27, 24, 0.62);
  }

  .mc-card-arrow {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #f5eee5;
    border: 1px solid #d5c6b7;
    color: #641f1f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease,
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .loved-card:hover .mc-card-arrow {
    background: #641f1f;
    color: #fffdf9;
    border-color: #641f1f;
    transform: rotate(45deg) scale(1.06);
  }

  .loved-moments-btn-wrapper {
    text-align: center;
    margin-top: 48px;
  }
</style>

<div class="mc-loved-wrapper">
  <div class="loved-moments-section">
    <div class="mc-loved-header" data-mc-reveal="fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <div class="mc-loved-eyebrow">
          <span>✦</span>
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="loved-moments-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="mc-loved-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="loved-moments-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign delay_ms = forloop.index0 | times: 90 -%}
        {%- capture card_index -%}{% if forloop.index < 10 %}0{{ forloop.index }}{% else %}{{ forloop.index }}{% endif %}{%- endcapture -%}

        {%- if collection != blank -%}
          <a
            href="{{ collection.url }}"
            class="loved-card"
            data-mc-tilt
            data-mc-reveal="fade-up"
            style="--mc-delay: {{ delay_ms }}ms;"
            {{ block.shopify_attributes }}
          >
            <div class="loved-card-image-wrapper">
              <div class="mc-card-top-meta">
                <span class="mc-card-index">{{ card_index }}</span>
                <span class="mc-card-pill">
                  {%- if collection.all_products_count > 0 -%}
                    {{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'Style', 'Styles' }}
                  {%- else -%}
                    Custom Studio
                  {%- endif -%}
                </span>
              </div>

              {%- if collection.image != blank -%}
                <img
                  src="{{ collection.image | image_url: width: 800 }}"
                  alt="{{ collection.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="840"
                >
              {%- elsif collection.products.first.featured_image != blank -%}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="840"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              <span class="mc-card-hover-cta">
                <span>Explore & Customise</span>
                <span>→</span>
              </span>
            </div>

            <div class="loved-card-content">
              <div class="mc-card-info">
                <h3 class="loved-card-title">{{ collection.title }}</h3>
                <div class="mc-card-rating-row">
                  <span class="loved-card-stars" aria-label="5 out of 5 stars">★★★★★</span>
                  <span class="mc-card-rating-label">Studio Craft</span>
                </div>
              </div>
              <span class="mc-card-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </div>
          </a>
        {%- else -%}
          <div
            class="loved-card"
            data-mc-tilt
            data-mc-reveal="fade-up"
            style="--mc-delay: {{ delay_ms }}ms;"
            {{ block.shopify_attributes }}
          >
            <div class="loved-card-image-wrapper">
              <div class="mc-card-top-meta">
                <span class="mc-card-index">{{ card_index }}</span>
                <span class="mc-card-pill">Custom Studio</span>
              </div>
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="loved-card-content">
              <div class="mc-card-info">
                <h3 class="loved-card-title">Personalised Collection</h3>
                <div class="mc-card-rating-row">
                  <span class="loved-card-stars">★★★★★</span>
                  <span class="mc-card-rating-label">Studio Craft</span>
                </div>
              </div>
              <span class="mc-card-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      {%- assign cta_url = section.settings.button_link | default: routes.collections_url -%}
      <div class="loved-moments-btn-wrapper" data-mc-reveal="fade-up" style="--mc-delay: 250ms;">
        <a href="{{ cta_url }}" class="mc-btn-luxury" data-mc-magnetic="0.2">
          <span>{{ section.settings.button_label }}</span>
          <span class="mc-btn-luxury__arrow">↗</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Loved Moments Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Badge",
      "default": "CURATED CUSTOM ESSENTIALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Most-Loved Moments"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted on heavyweight blanks with razor-sharp embroidery and high-definition studio print."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore All Collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loved Moments Grid",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}