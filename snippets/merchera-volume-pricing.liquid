{% comment %}
  Merchera Studio — Tiered Bulk Volume Discount Widget
  Tiers: 1–9 (Standard), 10–24 (15% Off), 25–49 (25% Off), 50+ (35% Off)
{% endcomment %}

{% liquid
  assign current_price = product.selected_or_first_available_variant.price | default: 2800
  assign p_tier1 = current_price
  assign p_tier2 = current_price | times: 0.85
  assign p_tier3 = current_price | times: 0.75
  assign p_tier4 = current_price | times: 0.65
%}

<div class="mc-volume-widget" id="mc-volume-widget-{{ section.id }}" data-base-price="{{ current_price }}">
  <div class="mc-volume-header">
    <div class="mc-volume-eyebrow">
      <span class="mc-volume-pulse"></span>
      <span>STUDIO BULK VOLUME TIERS</span>
    </div>
    <span class="mc-volume-badge">AUTO-APPLIED IN CART</span>
  </div>

  <div class="mc-volume-grid">
    <!-- Tier 1 -->
    <div class="mc-volume-card is-active" data-min-qty="1" data-discount="0" data-tier-name="1–9 Pcs">
      <div class="mc-volume-card__top">
        <span class="mc-volume-qty">1–9 pcs</span>
        <span class="mc-volume-tag mc-tag-standard">Standard</span>
      </div>
      <div class="mc-volume-price">
        <span class="mc-price-val">{{ p_tier1 | money }}</span>
        <span class="mc-price-unit">/ piece</span>
      </div>
      <div class="mc-volume-desc">Single samples & small personal runs</div>
    </div>

    <!-- Tier 2 -->
    <div class="mc-volume-card" data-min-qty="10" data-discount="0.15" data-tier-name="10–24 Pcs">
      <div class="mc-volume-card__top">
        <span class="mc-volume-qty">10–24 pcs</span>
        <span class="mc-volume-tag mc-tag-save">Save 15%</span>
      </div>
      <div class="mc-volume-price">
        <span class="mc-price-val">{{ p_tier2 | money }}</span>
        <span class="mc-price-unit">/ piece</span>
      </div>
      <div class="mc-volume-desc">Pop-ups, boutique teams & crews</div>
    </div>

    <!-- Tier 3: Most Popular -->
    <div class="mc-volume-card is-popular" data-min-qty="25" data-discount="0.25" data-tier-name="25–49 Pcs">
      <div class="mc-volume-popular-badge">MOST POPULAR</div>
      <div class="mc-volume-card__top">
        <span class="mc-volume-qty">25–49 pcs</span>
        <span class="mc-volume-tag mc-tag-save">Save 25%</span>
      </div>
      <div class="mc-volume-price">
        <span class="mc-price-val">{{ p_tier3 | money }}</span>
        <span class="mc-price-unit">/ piece</span>
      </div>
      <div class="mc-volume-desc">Agencies, corporate drops & events</div>
    </div>

    <!-- Tier 4 -->
    <div class="mc-volume-card" data-min-qty="50" data-discount="0.35" data-tier-name="50+ Pcs">
      <div class="mc-volume-card__top">
        <span class="mc-volume-qty">50+ pcs</span>
        <span class="mc-volume-tag mc-tag-save">Save 35%</span>
      </div>
      <div class="mc-volume-price">
        <span class="mc-price-val">{{ p_tier4 | money }}</span>
        <span class="mc-price-unit">/ piece</span>
      </div>
      <div class="mc-volume-desc">Enterprise orders & full retail batches</div>
    </div>
  </div>

  <div class="mc-volume-live-calc" id="mc-volume-calc-{{ section.id }}" style="display: none;">
    <div class="mc-calc-icon">✓</div>
    <div class="mc-calc-text">
      <strong class="mc-calc-tier">Tier Active</strong> — <span class="mc-calc-msg">Bulk pricing applied</span>
    </div>
  </div>

  <div class="mc-volume-footer">
    <span>✦ Need 100+ units or custom Pantone dye matching?</span>
    <a href="/pages/contact" class="mc-volume-consult-link">Request Studio Sample & Proof →</a>
  </div>
</div>

<style>
  .mc-volume-widget {
    background: #fffdf9;
    border: 1px solid #d5c6b7;
    border-radius: 20px;
    padding: 22px 20px;
    margin: 22px 0 26px;
    box-shadow: 0 10px 28px -10px rgba(33, 27, 24, 0.07);
    position: relative;
    overflow: hidden;
  }

  .mc-volume-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .mc-volume-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #641f1f;
    text-transform: uppercase;
  }

  .mc-volume-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #641f1f;
    animation: mcPulseDot 2s infinite;
  }

  .mc-volume-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(100, 31, 31, 0.08);
    color: #641f1f;
    border: 1px solid rgba(100, 31, 31, 0.18);
  }

  .mc-volume-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .mc-volume-card {
    background: #f5eee5;
    border: 1.5px solid #d5c6b7;
    border-radius: 14px;
    padding: 14px 12px;
    cursor: pointer;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mc-volume-card:hover {
    border-color: #641f1f;
    transform: translateY(-2px);
    box-shadow: 0 8px 18px -4px rgba(100, 31, 31, 0.14);
  }

  .mc-volume-card.is-active {
    background: #fffdf9;
    border-color: #641f1f;
    box-shadow: 0 0 0 2px #641f1f, 0 10px 22px -6px rgba(100, 31, 31, 0.22);
  }

  .mc-volume-popular-badge {
    position: absolute;
    top: -9px;
    left: 50%;
    transform: translateX(-50%);
    background: #641f1f;
    color: #fffdf9;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .mc-volume-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    gap: 4px;
  }

  .mc-volume-qty {
    font-size: 13px;
    font-weight: 700;
    color: #211b18;
  }

  .mc-volume-tag {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .mc-tag-standard {
    background: rgba(33, 27, 24, 0.08);
    color: rgba(33, 27, 24, 0.7);
  }

  .mc-tag-save {
    background: #641f1f;
    color: #fffdf9;
  }

  .mc-volume-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 6px;
  }

  .mc-price-val {
    font-size: 16px;
    font-weight: 700;
    color: #641f1f;
  }

  .mc-price-unit {
    font-size: 11px;
    color: rgba(33, 27, 24, 0.6);
  }

  .mc-volume-desc {
    font-size: 11px;
    line-height: 1.35;
    color: rgba(33, 27, 24, 0.65);
  }

  .mc-volume-live-calc {
    margin-top: 14px;
    padding: 10px 14px;
    background: rgba(100, 31, 31, 0.06);
    border: 1px solid rgba(100, 31, 31, 0.18);
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: #211b18;
    animation: mcPanelFade 0.3s ease;
  }

  .mc-calc-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #641f1f;
    color: #fffdf9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .mc-volume-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid rgba(213, 198, 183, 0.6);
    font-size: 12px;
    color: rgba(33, 27, 24, 0.72);
  }

  .mc-volume-consult-link {
    color: #641f1f;
    font-weight: 700;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .mc-volume-consult-link:hover {
    color: #451313;
  }

  @media screen and (max-width: 820px) {
    .mc-volume-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  (function() {
    const widget = document.getElementById('mc-volume-widget-{{ section.id }}');
    if (!widget) return;

    const cards = widget.querySelectorAll('.mc-volume-card');
    const calcBox = document.getElementById('mc-volume-calc-{{ section.id }}');
    const calcTier = calcBox ? calcBox.querySelector('.mc-calc-tier') : null;
    const calcMsg = calcBox ? calcBox.querySelector('.mc-calc-msg') : null;

    function getQtyInput() {
      return document.querySelector('form[action*="/cart/add"] input[name="quantity"]') ||
             document.querySelector('xo-quantity-input input[name="quantity"]') ||
             document.querySelector('input.xo-quantity__input') ||
             document.querySelector('input[type="number"][name="quantity"]');
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const minQty = parseInt(card.getAttribute('data-min-qty') || '1', 10);
        const discount = parseFloat(card.getAttribute('data-discount') || '0');
        const tierName = card.getAttribute('data-tier-name') || '';

        // Update active card
        cards.forEach((c) => c.classList.toggle('is-active', c === card));

        // Update quantity in product form
        const qtyInput = getQtyInput();
        if (qtyInput) {
          qtyInput.value = minQty;
          qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
          qtyInput.dispatchEvent(new Event('input', { bubbles: true }));
        }

        // Update live calc callout
        if (calcBox && calcTier && calcMsg) {
          if (discount > 0) {
            calcTier.textContent = `${tierName} Activated (${Math.round(discount * 100)}% Discount)`;
            calcMsg.textContent = `${minQty} pieces set. Bulk discount will be automatically applied at checkout!`;
            calcBox.style.display = 'flex';
          } else {
            calcBox.style.display = 'none';
          }
        }
      });
    });

    // Listen to quantity changes typed by user
    const qtyInput = getQtyInput();
    if (qtyInput) {
      qtyInput.addEventListener('input', () => {
        const val = parseInt(qtyInput.value || '1', 10);
        let selectedIndex = 0;
        if (val >= 50) selectedIndex = 3;
        else if (val >= 25) selectedIndex = 2;
        else if (val >= 10) selectedIndex = 1;
        else selectedIndex = 0;

        cards.forEach((c, idx) => c.classList.toggle('is-active', idx === selectedIndex));
      });
    }
  })();
</script>
