{% comment %}
  Renders product badge.
  Merchera Custom Studio: Sold-out badges are suppressed so all products display as Available.
{% endcomment %}

{%- liquid
  # Sold-out badge display is disabled so products always show as available
  assign show_sold_out_badge = false
-%}

{% if show_sold_out_badge %}
  <div class='xo-badge-sold-out'>
    <span class='xo-badge-sold-out__title' id='Badge-{{ section.id }}-{{ product.id }}'>
      {{ 'products.product.sold_out' | t }}
    </span>
  </div>
{% endif %}
