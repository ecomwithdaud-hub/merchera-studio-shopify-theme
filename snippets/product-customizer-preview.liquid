<div class="customization-box" id="customization-box-{{ section.id }}">

  <h3 class="customization-title">
    Customization Details
  </h3>

  <p class="customization-description">
    Tell us exactly how you want your product customized.
  </p>

  <label class="customization-label" for="custom-instructions-{{ section.id }}">
    Your Instructions<span class="required-star">*</span>
  </label>

  <textarea
    id="custom-instructions-{{ section.id }}"
    class="customization-textarea"
    placeholder="Write your customization requirements here (e.g., logo size, text, placement details)…"
    rows="5"
  ></textarea>

  <p class="customization-note">
    Please provide complete and accurate details so our UK studio crafts your product correctly.
  </p>

  <!-- IMAGE UPLOAD -->
  <label class="customization-label image-label">
    Upload Your Design / Reference Image
  </label>

  <p class="upload-description">
    Upload your logo, artwork, embroidery graphic, or reference image (PNG, JPG, WEBP up to 10 MB).
  </p>

  <label
    class="custom-upload-button"
    for="custom-image-{{ section.id }}"
  >
    📎 Choose Design / Logo
  </label>

  <input
    type="file"
    id="custom-image-{{ section.id }}"
    class="custom-image-input"
    accept="image/jpeg,image/png,image/webp"
  >

  <!-- IMAGE THUMBNAIL PREVIEW -->
  <div
    class="image-preview-wrapper"
    id="image-preview-{{ section.id }}"
    style="display:none;"
  >
    <img
      id="image-preview-img-{{ section.id }}"
      class="image-preview"
      alt="Uploaded artwork preview"
    >
    <button
      type="button"
      class="remove-image-button"
      id="remove-image-{{ section.id }}"
    >
      ✕ Remove image
    </button>
  </div>

  <!-- DESIGN PLACEMENT -->
  <div
    class="design-placement-section"
    id="design-placement-section-{{ section.id }}"
  >
    <label
      class="customization-label"
      for="design-placement-{{ section.id }}"
    >
      Design Placement<span class="required-star">*</span>
    </label>

    <p class="placement-description">
      Where would you like your design to be placed?
    </p>

    <select
      id="design-placement-{{ section.id }}"
      class="design-placement-select"
    >
      <option value="">
        Select placement…
      </option>
      <option value="chest">
        Chest (Top Right — As shown on shirt)
      </option>
      <option value="breast">
        Left Chest / Breast
      </option>
      <option value="center">
        Center Chest (Full Front)
      </option>
      <option value="right-sleeve">
        Right Sleeve
      </option>
      <option value="left-sleeve">
        Left Sleeve
      </option>
    </select>
  </div>

  <!-- LIVE PRODUCT PREVIEW -->
  <div
    class="custom-product-preview"
    id="custom-product-preview-{{ section.id }}"
    style="display:none;"
  >
    <div class="preview-heading">
      <h4>
        Preview Your Customization
      </h4>
      <p>
        Real-time visual simulation of your design on the product.
      </p>
    </div>

    <div class="preview-product-area" id="preview-product-area-{{ section.id }}">
      <img
        class="preview-product-image"
        id="preview-product-image-{{ section.id }}"
        src="{{ product.featured_image | image_url: width: 1200 }}"
        alt="{{ product.title }}"
      >
      <!-- Visual placement bounding guide -->
      <div class="preview-target-indicator" id="preview-target-indicator-{{ section.id }}">
        <span class="preview-target-badge">✦ Imprint Zone</span>
      </div>
      <img
        class="preview-design-image"
        id="preview-design-image-{{ section.id }}"
        alt="Your uploaded design"
      >
    </div>

    <div class="preview-placement-text">
      Selected Placement:
      <strong id="preview-placement-name-{{ section.id }}">
        —
      </strong>
    </div>

    <p class="preview-disclaimer">
      ✦ Studio preview indicates approximate position & scale. Our production team will align and proof your embroidery / print with optical precision prior to dispatch.
    </p>
  </div>

  <!-- ERRORS -->
  <p
    class="upload-error"
    id="upload-error-{{ section.id }}"
    style="display:none;"
  ></p>

  <p
    class="customization-error"
    id="customization-error-{{ section.id }}"
    style="display:none;"
  >
    Please enter your customization details before adding this product to cart.
  </p>

</div>

<style>
/* =========================================
   MERCHERA PRODUCT CUSTOMIZER & PLACEMENT
========================================= */

