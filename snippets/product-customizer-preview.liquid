<div class="customization-box" id="customization-box-{{ section.id }}">

  <h3 class="customization-title">
    Customization Details
  </h3>

  <p class="customization-description">
    Tell us exactly how you want your product customized.
  </p>

  <label class="customization-label" for="custom-instructions-{{ section.id }}">
    Your Instructions<span class="required-star">*</span>
  </label>

  <textarea
    id="custom-instructions-{{ section.id }}"
    class="customization-textarea"
    placeholder="Write your customization requirements here…"
    rows="6"
  ></textarea>

  <p class="customization-note">
    Please provide complete and accurate details so we can customize your product correctly.
  </p>

  <!-- IMAGE UPLOAD -->
  <label class="customization-label image-label">
    Upload Your Design / Reference Image
  </label>

  <p class="upload-description">
    You can upload your logo, artwork, design, or any reference image.
  </p>

  <label
    class="custom-upload-button"
    for="custom-image-{{ section.id }}"
  >
    📎 Choose Image
  </label>

  <input
    type="file"
    id="custom-image-{{ section.id }}"
    class="custom-image-input"
    accept="image/jpeg,image/png,image/webp"
  >

  <!-- IMAGE PREVIEW -->
  <div
    class="image-preview-wrapper"
    id="image-preview-{{ section.id }}"
    style="display:none;"
  >
    <img
      id="image-preview-img-{{ section.id }}"
      class="image-preview"
      alt="Customization image preview"
    >
    <button
      type="button"
      class="remove-image-button"
      id="remove-image-{{ section.id }}"
    >
      Remove image
    </button>
  </div>

  <!-- DESIGN PLACEMENT -->
  <div
    class="design-placement-section"
    id="design-placement-section-{{ section.id }}"
  >
    <label
      class="customization-label"
      for="design-placement-{{ section.id }}"
    >
      Design Placement<span class="required-star">*</span>
    </label>

    <p class="placement-description">
      Where would you like your design to be placed?
    </p>

    <select
      id="design-placement-{{ section.id }}"
      class="design-placement-select"
    >
      <option value="">
        Select placement
      </option>
      <option value="chest">
        Chest
      </option>
      <option value="breast">
        Breast
      </option>
      <option value="center">
        Center
      </option>
      <option value="right-sleeve">
        Right Sleeve
      </option>
      <option value="left-sleeve">
        Left Sleeve
      </option>
    </select>
  </div>

  <!-- LIVE PRODUCT PREVIEW -->
  <div
    class="custom-product-preview"
    id="custom-product-preview-{{ section.id }}"
    style="display:none;"
  >
    <div class="preview-heading">
      <h4>
        Preview Your Customization
      </h4>
      <p>
        See how your design may look on the product.
      </p>
    </div>

    <div class="preview-product-area">
      <img
        class="preview-product-image"
        id="preview-product-image-{{ section.id }}"
        src="{{ product.featured_image | image_url: width: 1200 }}"
        alt="{{ product.title }}"
      >
      <img
        class="preview-design-image"
        id="preview-design-image-{{ section.id }}"
        alt="Your uploaded design"
      >
    </div>

    <div class="preview-placement-text">
      Placement:
      <strong id="preview-placement-name-{{ section.id }}">
        —
      </strong>
    </div>

    <p class="preview-disclaimer">
      Preview is for placement guidance only. Final appearance may vary depending on product, design size, print method, and production.
    </p>
  </div>

  <!-- ERRORS -->
  <p
    class="upload-error"
    id="upload-error-{{ section.id }}"
    style="display:none;"
  ></p>

  <p
    class="customization-error"
    id="customization-error-{{ section.id }}"
    style="display:none;"
  >
    Please enter your customization details before adding this product to cart.
  </p>

</div>

<style>
/* =========================================
   MAIN CUSTOMIZATION BOX (ORIGINAL THEME)
========================================= */

.customization-box {
  margin: 22px 0;
  padding: 0;
}

.customization-title {
  margin: 0 0 8px;
  font-size: 18px;
  line-height: 1.3;
}

.customization-description {
  margin: 0 0 18px;
  font-size: 14px;
  line-height: 1.5;
}

.customization-label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 600;
}

.required-star {
  margin-left: 3px;
  color: #a82424;
}

.customization-textarea {
  display: block;
  width: 100%;
  min-height: 140px;
  padding: 14px;
  box-sizing: border-box;
  resize: vertical;
  font: inherit;
  font-size: 14px;
  border: 1px solid rgba(0,0,0,.2);
  border-radius: 6px;
  background: transparent;
}

.customization-textarea:focus {
  outline: none;
  border-color: currentColor;
}

.customization-note,
.upload-description,
.placement-description {
  margin: 7px 0 18px;
  font-size: 12px;
  line-height: 1.5;
  opacity: .7;
}

/* =========================================
   IMAGE UPLOAD
========================================= */

.image-label {
  margin-top: 20px;
  margin-bottom: 5px;
}

.custom-upload-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 11px 18px;
  border: 1px solid rgba(0,0,0,.25);
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  transition: opacity .2s ease;
}

.custom-upload-button:hover {
  opacity: .75;
}

.custom-image-input {
  display: none !important;
}

.image-preview-wrapper {
  margin-top: 14px;
}

.image-preview {
  display: block;
  max-width: 180px;
  max-height: 180px;
  border-radius: 6px;
  border: 1px solid rgba(0,0,0,.15);
  object-fit: contain;
}

.remove-image-button {
  margin-top: 8px;
  padding: 6px 10px;
  border: 0;
  background: transparent;
  text-decoration: underline;
  cursor: pointer;
  font: inherit;
  font-size: 12px;
}

/* =========================================
   DESIGN PLACEMENT
========================================= */

.design-placement-section {
  margin-top: 24px;
}

.design-placement-select {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border: 1px solid rgba(0,0,0,.2);
  border-radius: 6px;
  background: transparent;
  font: inherit;
  font-size: 14px;
  cursor: pointer;
  box-sizing: border-box;
}

.design-placement-select:focus {
  outline: none;
  border-color: currentColor;
}

/* =========================================
   LIVE PRODUCT PREVIEW (ORIGINAL THEME)
========================================= */

.custom-product-preview {
  margin-top: 28px;
  padding: 18px;
  border: 1px solid rgba(0,0,0,.12);
  border-radius: 10px;
  background: rgba(0,0,0,.02);
  box-sizing: border-box;
}

.preview-heading h4 {
  margin: 0 0 5px;
  font-size: 16px;
  line-height: 1.4;
}

.preview-heading p {
  margin: 0 0 18px;
  font-size: 12px;
  opacity: .7;
}

.preview-product-area {
  position: relative;
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  overflow: hidden;
  box-sizing: border-box;
}

.preview-product-image {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  margin: 0 auto;
  box-sizing: border-box;
}

.preview-design-image {
  position: absolute;
  display: none;
  width: 90px;
  height: 90px;
  object-fit: contain;
  transform: translate(-50%, -50%);
  pointer-events: none;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box !important;
}

/* =========================================
   PLACEMENT POSITIONS (CALIBRATED ON GARMENT)
========================================= */

/* Chest — Top right chest / "YOUR DESIGN HERE" */
.preview-product-area.placement-chest .preview-design-image {
  display: block;
  left: 58%;
  top: 32%;
  width: 75px;
  height: 75px;
}

/* Breast — Left chest pocket area */
.preview-product-area.placement-breast .preview-design-image {
  display: block;
  left: 58%;
  top: 32%;
  width: 70px;
  height: 70px;
}

/* Center — Center front chest */
.preview-product-area.placement-center .preview-design-image {
  display: block;
  left: 50%;
  top: 48%;
  width: 120px;
  height: 120px;
}

/* Right Sleeve — Sits directly ON the right sleeve */
.preview-product-area.placement-right-sleeve .preview-design-image {
  display: block;
  left: 67%;
  top: 45%;
  width: 60px;
  height: 60px;
}

/* Left Sleeve — Sits directly ON the left sleeve */
.preview-product-area.placement-left-sleeve .preview-design-image {
  display: block;
  left: 33%;
  top: 45%;
  width: 60px;
  height: 60px;
}

/* =========================================
   PREVIEW TEXT
========================================= */

.preview-placement-text {
  margin-top: 14px;
  text-align: center;
  font-size: 13px;
}

.preview-disclaimer {
  margin: 10px 0 0;
  font-size: 11px;
  line-height: 1.5;
  opacity: .6;
  text-align: center;
}

/* =========================================
   ERRORS
========================================= */

.upload-error,
.customization-error {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.4;
  color: #c62828;
}

/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 749px) {
  .custom-upload-button {
    width: 100%;
  }
}
</style>

<script>
(function() {
  function initCustomizer() {
    const box = document.getElementById('customization-box-{{ section.id }}');
    if (!box) return;

    const textarea = box.querySelector('.customization-textarea');
    const imageInput = box.querySelector('.custom-image-input');
    const previewWrapper = box.querySelector('.image-preview-wrapper');
    const previewImage = box.querySelector('.image-preview');
    const removeImageButton = box.querySelector('.remove-image-button');
    const uploadError = box.querySelector('.upload-error');
    const customizationError = box.querySelector('.customization-error');
    const placementSelect = box.querySelector('.design-placement-select');
    const productPreview = box.querySelector('.custom-product-preview');
    const previewArea = box.querySelector('.preview-product-area');
    const previewDesign = box.querySelector('.preview-design-image');
    const previewPlacementName = box.querySelector('.preview-placement-text strong');

    /* =========================================
       PRODUCT FORM
    ========================================= */
    function getProductForm() {
      return document.querySelector('form[action*="/cart/add"]');
    }

    function getOrCreateProperty(form, propertyName) {
      let input = form.querySelector('input[data-custom-property="' + propertyName + '"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'properties[' + propertyName + ']';
        input.setAttribute('data-custom-property', propertyName);
        form.appendChild(input);
      }
      return input;
    }

    /* =========================================
       SETUP FORM
    ========================================= */
    function setupForm() {
      const form = getProductForm();
      if (!form) return;

      form.setAttribute('enctype', 'multipart/form-data');

      const instructionsProperty = getOrCreateProperty(form, 'Customization Details');
      const imageProperty = getOrCreateProperty(form, 'Customization Image');
      const placementProperty = getOrCreateProperty(form, 'Design Placement');

      function syncText() {
        if (instructionsProperty && textarea) {
          instructionsProperty.value = textarea.value.trim();
        }
      }

      function syncPlacement() {
        if (placementProperty && placementSelect) {
          placementProperty.value = placementSelect.value;
        }
      }

      if (imageInput && imageInput.parentElement !== form) {
        form.appendChild(imageInput);
        imageInput.name = 'properties[Customization Image]';
      }

      /* =========================================
         IMAGE UPLOAD
      ========================================= */
      if (imageInput && !imageInput.dataset.bound) {
        imageInput.dataset.bound = 'true';
        imageInput.addEventListener('change', function() {
          if (uploadError) uploadError.style.display = 'none';
          const file = imageInput.files[0];

          if (!file) {
            if (previewWrapper) previewWrapper.style.display = 'none';
            if (productPreview) productPreview.style.display = 'none';
            return;
          }

          if (!file.type.startsWith('image/')) {
            if (uploadError) {
              uploadError.textContent = 'Please upload an image file.';
              uploadError.style.display = 'block';
            }
            imageInput.value = '';
            if (previewWrapper) previewWrapper.style.display = 'none';
            if (productPreview) productPreview.style.display = 'none';
            return;
          }

          if (file.size > 10 * 1024 * 1024) {
            if (uploadError) {
              uploadError.textContent = 'Image must be smaller than 10 MB.';
              uploadError.style.display = 'block';
            }
            imageInput.value = '';
            if (previewWrapper) previewWrapper.style.display = 'none';
            if (productPreview) productPreview.style.display = 'none';
            return;
          }

          const reader = new FileReader();
          reader.onload = function(event) {
            const imageURL = event.target.result;
            if (previewImage) previewImage.src = imageURL;
            if (previewWrapper) previewWrapper.style.display = 'block';

            if (previewDesign) previewDesign.src = imageURL;
            if (productPreview) productPreview.style.display = 'block';

            updateProductPreview();
          };
          reader.readAsDataURL(file);
        });
      }

      /* =========================================
         REMOVE IMAGE
      ========================================= */
      if (removeImageButton && !removeImageButton.dataset.bound) {
        removeImageButton.dataset.bound = 'true';
        removeImageButton.addEventListener('click', function() {
          if (imageInput) imageInput.value = '';
          if (previewImage) previewImage.src = '';
          if (previewDesign) previewDesign.src = '';
          if (previewWrapper) previewWrapper.style.display = 'none';
          if (productPreview) productPreview.style.display = 'none';
          if (uploadError) uploadError.style.display = 'none';
        });
      }

      /* =========================================
         TEXT INPUT
      ========================================= */
      if (textarea && !textarea.dataset.bound) {
        textarea.dataset.bound = 'true';
        textarea.addEventListener('input', function() {
          syncText();
          if (textarea.value.trim() && customizationError) {
            customizationError.style.display = 'none';
          }
        });
      }

      /* =========================================
         PLACEMENT CHANGE
      ========================================= */
      if (placementSelect && !placementSelect.dataset.bound) {
        placementSelect.dataset.bound = 'true';
        placementSelect.addEventListener('change', function() {
          syncPlacement();
          updateProductPreview();
        });
      }

      /* =========================================
         UPDATE LIVE PREVIEW
      ========================================= */
      function updateProductPreview() {
        if (!previewArea || !placementSelect) return;
        const placement = placementSelect.value;

        previewArea.classList.remove(
          'placement-chest',
          'placement-breast',
          'placement-center',
          'placement-right-sleeve',
          'placement-left-sleeve'
        );

        if (!placement) {
          if (previewPlacementName) previewPlacementName.textContent = '—';
          if (previewDesign) previewDesign.style.display = 'none';
          return;
        }

        previewArea.classList.add('placement-' + placement);

        const placementNames = {
          'chest': 'Chest',
          'breast': 'Breast',
          'center': 'Center',
          'right-sleeve': 'Right Sleeve',
          'left-sleeve': 'Left Sleeve'
        };

        if (previewPlacementName) {
          previewPlacementName.textContent = placementNames[placement] || placement;
        }

        if (previewDesign && previewDesign.getAttribute('src')) {
          previewDesign.style.display = 'block';
        }
      }

      /* =========================================
         VALIDATE ADD TO CART
      ========================================= */
      if (form && !form.dataset.boundCustomizer) {
        form.dataset.boundCustomizer = 'true';
        form.addEventListener('submit', function(event) {
          syncText();
          syncPlacement();

          if (textarea && !textarea.value.trim()) {
            event.preventDefault();
            if (customizationError) customizationError.style.display = 'block';
            textarea.focus();
            return false;
          }

          if (placementSelect && !placementSelect.value) {
            event.preventDefault();
            alert('Please select where you want your design to be placed.');
            placementSelect.focus();
            return false;
          }

          if (imageProperty) {
            if (imageInput && imageInput.files && imageInput.files.length) {
              imageProperty.value = imageInput.files[0].name;
            } else {
              imageProperty.value = '';
            }
          }
        }, true);
      }
    }

    setupForm();

    const observer = new MutationObserver(function() {
      setupForm();
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomizer);
  } else {
    initCustomizer();
  }
})();
</script>
